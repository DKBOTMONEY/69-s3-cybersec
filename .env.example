# ============================================
# COPY ไฟล์นี้ไปเป็น .env แล้วใส่ค่าความปลอดภัยของคุณเอง
# ห้ามใช้ค่าตัวอย่างนี้ตอน deploy จริง
# ห้าม commit ไฟล์ .env (เพิ่มใน .gitignore แล้ว)
# ============================================

# Database (username/password ต้องไม่ใช้ค่า default)
DB_HOST=db
DB_USER=change_me_db_user
DB_PASSWORD=change_me_strong_db_password
DB_NAME=cybersec_db
DB_PORT=54327

# pgAdmin (admin panel ของ database)
PGADMIN_EMAIL=change_me_admin@example.com
PGADMIN_PASSWORD=change_me_strong_admin_password
PGADMIN_PORT=8080

# Strapi App
APP_PORT=8083

# Mailpit (Mock Email Server & Web UI)
MAILPIT_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
# Mailpit Web UI Auth (ป้องกันการดักอ่าน Reset Token ตามหลัก IAAA - Authentication)
# รูปแบบ: username:password (เว้นว่างไว้หากไม่ต้องการรหัสผ่านในสภาพแวดล้อม dev)
MAILPIT_UI_AUTH=

# Strapi Security Secrets
# - ใช้คำสั่ง: openssl rand -base64 32 เพื่อสุ่มค่า
# - APP_KEYS ต้องเป็น comma-separated อย่างน้อย 1 ค่า
APP_KEYS=change_me_key1,change_me_key2
API_TOKEN_SALT=change_me_api_token_salt
ADMIN_JWT_SECRET=change_me_admin_jwt_secret
JWT_SECRET=change_me_jwt_secret
TRANSFER_TOKEN_SALT=change_me_transfer_token_salt

# Centralized Credentials สำหรับทดสอบระบบผ่าน api.rest
ADMIN_EMAIL=change_me_admin@example.com
ADMIN_PASSWORD=change_me_strong_admin_password
ADMIN_FIRSTNAME=change_me_admin_firstname
ADMIN_LASTNAME=change_me_admin_lastname
ADMIN_RESET_TOKEN=
ADMIN_NEW_PASSWORD=change_me_new_admin_password
REMEMBER_ME=true
ADMIN_TOKEN=

DEFAULT_ADMIN_EMAIL=change_me_default_admin@example.com
DEFAULT_ADMIN_PASSWORD=change_me_strong_default_password

USER_USERNAME=change_me_username
USER_EMAIL=change_me_user@example.com
USER_PASSWORD=change_me_strong_user_password
USER_IDENTIFIER=change_me_user@example.com
USER_RESET_CODE=
USER_NEW_PASSWORD=change_me_new_user_password
USER_TOKEN=

# Content Section Variables (Student, Subject, Teacher)
STUDENT_ID=1
STUDENT_CODE=STD001
STUDENT_FIRSTNAME=Somchai
STUDENT_LASTNAME=Jaidee
STUDENT_UPDATE_FIRSTNAME=Somchai_Updated

SUBJECT_ID=1
SUBJECT_CODE=CS101
SUBJECT_NAME=Cyber Security
SUBJECT_UPDATE_NAME=Advanced Cyber Security

TEACHER_ID=1
TEACHER_CODE=TCH001
TEACHER_FIRSTNAME=Prawee
TEACHER_LASTNAME=Wongsa
TEACHER_UPDATE_FIRSTNAME=Prawee_Updated