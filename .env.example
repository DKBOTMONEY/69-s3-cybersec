# ============================================
# COPY ไฟล์นี้ไปเป็น .env แล้วใส่ค่าความปลอดภัยของคุณเอง
# ห้ามใช้ค่าตัวอย่างนี้ตอน deploy จริง
# ห้าม commit ไฟล์ .env (เพิ่มใน .gitignore แล้ว)
# ============================================

# Database (username/password ต้องไม่ใช้ค่า default)
DB_HOST=db
DB_USER=change_me_db_user
DB_PASSWORD=change_me_strong_db_password
DB_NAME=cybersec_db
DB_PORT=54327

# pgAdmin (admin panel ของ database)
PGADMIN_EMAIL=change_me_admin@example.com
PGADMIN_PASSWORD=change_me_strong_admin_password
PGADMIN_PORT=8080

# Strapi App
APP_PORT=8083

# Mailpit (Mock Email Server & Web UI)
MAILPIT_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025

# Strapi Security Secrets
# - ใช้คำสั่ง: openssl rand -base64 32 เพื่อสุ่มค่า
# - APP_KEYS ต้องเป็น comma-separated อย่างน้อย 1 ค่า
APP_KEYS=change_me_key1,change_me_key2
API_TOKEN_SALT=change_me_api_token_salt
ADMIN_JWT_SECRET=change_me_admin_jwt_secret
JWT_SECRET=change_me_jwt_secret
TRANSFER_TOKEN_SALT=change_me_transfer_token_salt